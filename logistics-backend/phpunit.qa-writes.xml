<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Unit"><directory>tests/Unit</directory></testsuite>
        <testsuite name="Feature"><directory>tests/Feature</directory></testsuite>
    </testsuites>
    <source><include><directory>app</directory></include></source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_CONFIG_CACHE" value="bootstrap/cache/config.qa.php" force="true"/>
        <env name="APP_SERVICES_CACHE" value="bootstrap/cache/services.qa.php" force="true"/>
        <env name="APP_PACKAGES_CACHE" value="bootstrap/cache/packages.qa.php" force="true"/>
        <env name="APP_EVENTS_CACHE" value="bootstrap/cache/events.qa.php" force="true"/>
        <env name="LARAVEL_STORAGE_PATH" value="storage/qa" force="true"/>
        <env name="VIEW_COMPILED_PATH" value="storage/qa/framework/views" force="true"/>
        <env name="SESSION_COOKIE" value="viettrung_qa_session" force="true"/>
        <env name="LIGHTHOUSE_SCHEMA_CACHE_ENABLE" value="false" force="true"/>
        <env name="LIGHTHOUSE_SCHEMA_CACHE_PATH" value="bootstrap/cache/lighthouse-schema.qa.php" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BUSINESS_WRITES_ENABLED" value="true" force="true"/>
        <env name="FINANCIAL_WRITES_ENABLED" value="true" force="true"/>
        <env name="CUSTOMER_EMAIL_VERIFICATION_REQUIRED" value="true" force="true"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3311" force="true"/>
        <env name="DB_DATABASE" value="logistics_system_test" force="true"/>
        <env name="DB_USERNAME" value="viettrung_qa_runner" force="true"/>
        <env name="TEST_DATABASE_NAME" value="logistics_system_test" force="true"/>
        <env name="TEST_DATABASE_HOST" value="127.0.0.1" force="true"/>
        <env name="TEST_DATABASE_PORT" value="3311" force="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
