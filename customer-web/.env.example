# Customer Portal preview is development-only and never grants authentication.
VITE_ENABLE_CUSTOMER_PORTAL_DEMO=true
# Supported development states: ready, loading, error, empty
VITE_CUSTOMER_PORTAL_DEMO_STATE=ready

# Leave empty behind a same-origin reverse proxy; otherwise use the Laravel origin.
VITE_CUSTOMER_API_URL=

# Comma-separated IDs allow QA and production builds to coexist. Never use an ad-hoc ID in production.
VITE_CUSTOMER_EXTENSION_IDS=

# Local Customer Web origins are centralized in ../config/local-development.mjs.
# Release builds must keep the website origin aligned with CUSTOMER_EXTENSION_ORIGINS used by the Extension build.
