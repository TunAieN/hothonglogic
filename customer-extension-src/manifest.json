{
  "manifest_version": 3,
  "name": "VietTrung Order - Trợ lý sản phẩm",
  "version": "1.0.0",
  "description": "Tự động đọc sản phẩm Taobao, Tmall và 1688 khi khách dán link trên VietTrung Order.",
  "background": { "service_worker": "background/background.js", "type": "module" },
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": ["*://*.taobao.com/*", "*://*.tmall.com/*", "*://*.1688.com/*"],
  "content_scripts": [{
    "matches": ["*://*.taobao.com/*", "*://*.tmall.com/*", "*://*.1688.com/*"],
    "js": ["shared/sku-extractor.js", "shared/product-contract.js", "content/scraper.js", "content/content.js"],
    "run_at": "document_idle"
  }],
  "externally_connectable": {
    "matches": ["http://localhost/*", "http://127.0.0.1/*"]
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
